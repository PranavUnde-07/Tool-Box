PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MAX_IMAGE_SIZE_MB=50
MAX_PDF_SIZE_MB=100
TEMP_CLEANUP_DELAY_MS=5000

# ─── Ghostscript ───────────────────────────────────────────────────
# Windows (default install path — adjust version number if needed):
# GS_PATH=C:\Program Files\gs\gs10.05.1\bin\gswin64c.exe
# Or if gs/gswin64c is on your system PATH, just use:
GS_PATH=gswin64c

# macOS / Linux:
# GS_PATH=gs
